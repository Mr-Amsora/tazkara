            "url": { "raw": "{{baseUrl}}/api/organizer/events/{{eventId}}/bookings?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "organizer", "events", "{{eventId}}", "bookings"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
          }
        },
